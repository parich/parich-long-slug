#. Plugin Name of the plugin
#: parich-long-slug.php
#: includes/class-parich-slug-admin.php:87
#: includes/class-parich-slug-admin.php:334
msgid "Parich Long Slug"
msgstr "Parich Long Slug"

#. Plugin URI of the plugin
#: parich-long-slug.php
msgid "https://github.com/parich/parich-long-slug"
msgstr "https://github.com/parich/parich-long-slug"

#. Description of the plugin
#: parich-long-slug.php
msgid "Long, Thai-friendly post and term slugs that survive WordPress updates, with a repair tool for slugs damaged by Long URL Maker."
msgstr "slug ของเรื่องและหมวดหมู่ที่ยาวได้และรองรับภาษาไทย ไม่ถูกตัดเมื่ออัปเดต WordPress พร้อมเครื่องมือกู้คืน slug ที่ Long URL Maker ทำเสียหาย"

#. Author of the plugin
#: parich-long-slug.php
msgid "Mr.Parich Suriya"
msgstr "Mr.Parich Suriya"

#. Author URI of the plugin
#: parich-long-slug.php
msgid "https://github.com/parich"
msgstr "https://github.com/parich"

#: includes/class-parich-slug-admin.php:67
msgid "The longest slug must be a number. The previous value was kept."
msgstr "ความยาวสูงสุดของ slug ต้องเป็นตัวเลข จึงคงค่าเดิมไว้"

#. translators: 1: saved value, 2: lowest allowed, 3: highest allowed
#: includes/class-parich-slug-admin.php:77
#, php-format
msgid "The longest slug was set to %1$d: it must be between %2$d and %3$d."
msgstr "ตั้งความยาวสูงสุดของ slug เป็น %1$d เพราะต้องอยู่ระหว่าง %2$d ถึง %3$d"

#: includes/class-parich-slug-admin.php:88
msgid "Long Slug"
msgstr "Long Slug"

#: includes/class-parich-slug-admin.php:98
#: includes/class-parich-slug-admin.php:329
msgid "Settings"
msgstr "ตั้งค่า"

#: includes/class-parich-slug-admin.php:109
#: includes/class-parich-slug-admin.php:419
msgid "Donate"
msgstr "บริจาค"

#: includes/class-parich-slug-admin.php:125
msgid "The preview could not be loaded."
msgstr "โหลดตัวอย่างไม่ได้"

#. translators: 1: length in bytes, 2: longest allowed
#: includes/class-parich-slug-admin.php:152
#, php-format
msgid "%1$d of %2$d bytes"
msgstr "%1$d จาก %2$d ไบต์"

#: includes/class-parich-slug-admin.php:154
msgid "cut to fit"
msgstr "ตัดให้พอดี"

#: includes/class-parich-slug-admin.php:194
msgid "Slug columns"
msgstr "คอลัมน์ slug"

#: includes/class-parich-slug-admin.php:197
msgid "Long slugs are off until both columns are varchar(2000). Use \"Set up again\" below."
msgstr "slug ยาวยังใช้ไม่ได้จนกว่าทั้งสองคอลัมน์จะเป็น varchar(2000) ใช้ปุ่ม \"ตั้งค่าใหม่อีกครั้ง\" ด้านล่าง"

#: includes/class-parich-slug-admin.php:205
msgid "Character set"
msgstr "ชุดอักขระ"

#: includes/class-parich-slug-admin.php:208
msgid "Not UTF-8. Slugs still work because they are stored percent-encoded (plain ASCII), but titles in Thai may not be stored correctly elsewhere."
msgstr "ไม่ใช่ UTF-8: slug ยังใช้ได้เพราะเก็บแบบเข้ารหัส URL (ASCII ล้วน) แต่ชื่อเรื่องภาษาไทยในส่วนอื่นอาจเก็บไม่ถูกต้อง"

#: includes/class-parich-slug-admin.php:215
msgid "Missing"
msgstr "ไม่มี"

#: includes/class-parich-slug-admin.php:215
msgid "Without it, a WordPress update can cut slugs longer than 200 characters (they are restored from the shadow copy afterwards). Use \"Set up again\" below."
msgstr "ถ้าไม่มีไฟล์นี้ การอัปเดต WordPress อาจตัด slug ที่ยาวเกิน 200 ตัวอักษร (ปลั๊กอินจะคืนค่าจากสำเนาสำรองภายหลัง) ใช้ปุ่ม \"ตั้งค่าใหม่อีกครั้ง\" ด้านล่าง"

#. translators: 1: installed version, 2: bundled version
#: includes/class-parich-slug-admin.php:218
#, php-format
msgid "Version %1$s (current: %2$s)"
msgstr "เวอร์ชัน %1$s (ปัจจุบัน: %2$s)"

#. translators: 1: installed version, 2: bundled version
#: includes/class-parich-slug-admin.php:218
msgid "It is updated the next time an administrator opens wp-admin."
msgstr "จะอัปเดตเมื่อผู้ดูแลเปิด wp-admin ครั้งถัดไป"

#. translators: %s: version
#: includes/class-parich-slug-admin.php:221
#, php-format
msgid "Installed, version %s"
msgstr "ติดตั้งแล้ว เวอร์ชัน %s"

#: includes/class-parich-slug-admin.php:223
msgid "Guard (must-use plugin)"
msgstr "ไฟล์ป้องกัน (must-use plugin)"

#: includes/class-parich-slug-admin.php:232
msgid "Shadow copy of long slugs"
msgstr "สำเนาสำรองของ slug ยาว"

#. translators: %d: number of slugs
#: includes/class-parich-slug-admin.php:234
#, php-format
msgid "%d slug longer than 200 characters"
msgid_plural "%d slugs longer than 200 characters"
msgstr[0] "slug ที่ยาวเกิน 200 ตัวอักษร %d รายการ"

#. translators: %d: number of slugs
#: includes/class-parich-slug-admin.php:234
msgid "Table missing"
msgstr "ไม่มีตาราง"

#: includes/class-parich-slug-admin.php:236
msgid "Use \"Set up again\" below."
msgstr "ใช้ปุ่ม \"ตั้งค่าใหม่อีกครั้ง\" ด้านล่าง"

#. translators: 1: date, 2: restored slugs, 3: slugs left alone
#: includes/class-parich-slug-admin.php:243
#, php-format
msgid "%1$s — restored %2$d, left alone %3$d"
msgstr "%1$s — คืนค่า %2$d รายการ ไม่แตะ %3$d รายการ"

#: includes/class-parich-slug-admin.php:248
#: includes/class-parich-slug-admin.php:250
msgid "Last repair after a WordPress update"
msgstr "การซ่อมครั้งล่าสุดหลังอัปเดต WordPress"

#: includes/class-parich-slug-admin.php:248
msgid "The guard was missing during that update."
msgstr "ตอนอัปเดตครั้งนั้นไม่มีไฟล์ป้องกัน"

#: includes/class-parich-slug-admin.php:250
msgid "Never needed"
msgstr "ยังไม่เคยต้องซ่อม"

#. translators: %s: 2,048
#: includes/class-parich-slug-admin.php:257
#, php-format
msgid "Links longer than %s characters"
msgstr "ลิงก์ที่ยาวเกิน %s ตัวอักษร"

#: includes/class-parich-slug-admin.php:260
msgid "None"
msgstr "ไม่มี"

#: includes/class-parich-slug-admin.php:262
msgid "Some browsers, crawlers and sitemap readers refuse links this long. Shorten these slugs or their parent pages."
msgstr "เบราว์เซอร์ โปรแกรมเก็บข้อมูลเว็บ และตัวอ่าน sitemap บางตัวไม่รับลิงก์ที่ยาวขนาดนี้ ควรย่อ slug เหล่านี้หรือของหน้าแม่"

#: includes/class-parich-slug-admin.php:267
#: includes/class-parich-slug-admin.php:287
#: includes/class-parich-slug-admin.php:289
msgid "Long URL Maker"
msgstr "Long URL Maker"

#: includes/class-parich-slug-admin.php:267
msgid "Active"
msgstr "เปิดใช้งานอยู่"

#: includes/class-parich-slug-admin.php:267
msgid "Deactivate it with the button in the notice above, not the usual Deactivate link."
msgstr "ปิดใช้งานด้วยปุ่มในประกาศด้านบน ไม่ใช่ลิงก์ปิดใช้งานแบบปกติ"

#. translators: %d: rows
#: includes/class-parich-slug-admin.php:272
#, php-format
msgid "its backup table has %d row"
msgid_plural "its backup table has %d rows"
msgstr[0] "ตารางสำรองของปลั๊กอินนี้มี %d แถว"

#: includes/class-parich-slug-admin.php:275
msgid "its settings are still stored"
msgstr "ค่าตั้งของปลั๊กอินนี้ยังเก็บอยู่"

#: includes/class-parich-slug-admin.php:277
msgid "It was used on this site, so some slugs may have been cut or rewritten by it."
msgstr "เคยใช้งานบนเว็บนี้ จึงอาจมี slug ที่ถูกตัดหรือถูกเขียนใหม่"

#: includes/class-parich-slug-admin.php:285
#: includes/repair/class-parich-slug-repair-admin.php:560
msgid "Scan for damaged slugs"
msgstr "สแกนหา slug ที่เสียหาย"

#: includes/class-parich-slug-admin.php:287
msgid "Installed, inactive"
msgstr "ติดตั้งอยู่ ปิดใช้งาน"

#: includes/class-parich-slug-admin.php:287
msgid "Removed"
msgstr "ถอนออกแล้ว"

#: includes/class-parich-slug-admin.php:289
msgid "Installed, never used"
msgstr "ติดตั้งอยู่ ไม่เคยใช้งาน"

#: includes/class-parich-slug-admin.php:289
msgid "Not installed"
msgstr "ไม่ได้ติดตั้ง"

#: includes/class-parich-slug-admin.php:324
msgid "Sorry, you are not allowed to manage Parich Long Slug."
msgstr "ขออภัย คุณไม่มีสิทธิ์จัดการ Parich Long Slug"

#: includes/class-parich-slug-admin.php:330
msgid "Repair slugs"
msgstr "กู้คืน slug"

#: includes/class-parich-slug-admin.php:335
msgid "Secondary menu"
msgstr "เมนูรอง"

#: includes/class-parich-slug-admin.php:354
msgid "Longest new slug"
msgstr "ความยาวสูงสุดของ slug ใหม่"

#: includes/class-parich-slug-admin.php:357
msgid "bytes"
msgstr "ไบต์"

#. translators: 1: lowest, 2: highest, 3: Thai characters at the current value
#: includes/class-parich-slug-admin.php:362
#, php-format
msgid "Between %1$d and %2$d, counted after percent-encoding: a Thai character takes 9 bytes and an English letter or digit 1, so the current value fits about %3$d Thai characters. WordPress alone stops at 200. Only new and edited slugs follow this setting; existing slugs are not changed."
msgstr "ระหว่าง %1$d ถึง %2$d นับหลังเข้ารหัส URL: ตัวอักษรไทย 1 ตัวใช้ 9 ไบต์ ตัวอักษรอังกฤษหรือตัวเลขใช้ 1 ไบต์ ค่าปัจจุบันจึงได้ภาษาไทยประมาณ %3$d ตัว (WordPress ปกติหยุดที่ 200) ค่านี้ใช้กับ slug ใหม่และที่แก้ไขเท่านั้น slug เดิมไม่เปลี่ยน"

#: includes/class-parich-slug-admin.php:372
msgid "Try a title"
msgstr "ลองพิมพ์ชื่อเรื่อง"

#: includes/class-parich-slug-admin.php:385
msgid "Status"
msgstr "สถานะ"

#: includes/class-parich-slug-admin.php:408
msgid "Set up again"
msgstr "ตั้งค่าใหม่อีกครั้ง"

#: includes/class-parich-slug-admin.php:409
msgid "Widens the slug columns, installs the guard and creates the shadow table if any of them is missing. Safe to repeat."
msgstr "ขยายคอลัมน์ slug ติดตั้งไฟล์ป้องกัน และสร้างตารางสำเนาสำรองถ้ายังขาดอยู่ กดซ้ำได้อย่างปลอดภัย"

#: includes/class-parich-slug-admin.php:417
msgid "Support this plugin"
msgstr "สนับสนุนปลั๊กอินนี้"

#: includes/class-parich-slug-admin.php:418
msgid "Parich Long Slug is free, with every feature for everyone. If it is useful to you, you can support its development:"
msgstr "Parich Long Slug ใช้งานได้ฟรี ทุกคนได้ทุกความสามารถ ถ้ามีประโยชน์กับคุณ สามารถสนับสนุนการพัฒนาได้ที่นี่:"

#: includes/class-parich-slug-admin.php:420
msgid "Secure payment by Stripe."
msgstr "ชำระเงินอย่างปลอดภัยผ่าน Stripe"

#: includes/class-parich-slug-guard.php:73
msgid "WordPress cannot write files directly on this server."
msgstr "WordPress เขียนไฟล์บนเซิร์ฟเวอร์นี้โดยตรงไม่ได้"

#: includes/class-parich-slug-guard.php:77
msgid "The guard template is missing."
msgstr "ไม่พบแม่แบบของไฟล์ป้องกัน"

#: includes/class-parich-slug-guard.php:80
msgid "The folder could not be created."
msgstr "สร้างโฟลเดอร์ไม่ได้"

#: includes/class-parich-slug-guard.php:84
#: includes/class-parich-slug-guard.php:88
msgid "The file could not be written."
msgstr "เขียนไฟล์ไม่ได้"

#: includes/class-parich-slug-guard.php:105
msgid "The file could not be deleted."
msgstr "ลบไฟล์ไม่ได้"

#. translators: 1: reason, 2: file path
#: includes/class-parich-slug-guard.php:131
#, php-format
msgid "The guard file could not be installed at %2$s: %1$s Without it, a WordPress update can shorten slugs longer than 200 characters."
msgstr "ติดตั้งไฟล์ป้องกันที่ %2$s ไม่ได้: %1$s ถ้าไม่มีไฟล์นี้ การอัปเดต WordPress อาจตัด slug ที่ยาวเกิน 200 ตัวอักษร"

#: includes/class-parich-slug-legacy.php:164
msgid "Sorry, you are not allowed to deactivate this plugin."
msgstr "ขออภัย คุณไม่มีสิทธิ์ปิดใช้งานปลั๊กอินนี้"

#: includes/class-parich-slug-legacy.php:197
msgid "Long URL Maker was deactivated without running its deactivation routine. Your slugs were not changed."
msgstr "ปิดใช้งาน Long URL Maker แล้วโดยไม่ให้ขั้นตอนปิดใช้งานของมันทำงาน slug ของคุณไม่ถูกเปลี่ยน"

#: includes/class-parich-slug-legacy.php:202
msgid "Long URL Maker was switched off again right after activation, before its activation routine could write old slugs over the current ones. Keep it inactive while Parich Long Slug is active."
msgstr "Long URL Maker ถูกปิดอีกครั้งทันทีหลังเปิดใช้งาน ก่อนที่ขั้นตอนเปิดใช้งานของมันจะเขียน slug เก่าทับของปัจจุบัน กรุณาปิดไว้ขณะที่ Parich Long Slug เปิดอยู่"

#: includes/class-parich-slug-legacy.php:213
msgid "Long URL Maker is active."
msgstr "Long URL Maker เปิดใช้งานอยู่"

#: includes/class-parich-slug-legacy.php:214
msgid "When it is deactivated it rebuilds every slug from the post title and shortens the slug columns, which changes your URLs. Parich Long Slug has switched those actions off while both plugins are active. Turn Long URL Maker off with this button:"
msgstr "เมื่อถูกปิดใช้งาน มันจะสร้าง slug ใหม่ทั้งหมดจากชื่อเรื่องและหดคอลัมน์ slug ทำให้ URL ของคุณเปลี่ยน Parich Long Slug ปิดการทำงานเหล่านั้นไว้ขณะที่ทั้งสองปลั๊กอินเปิดอยู่ ปิด Long URL Maker ด้วยปุ่มนี้:"

#: includes/class-parich-slug-legacy.php:219
msgid "Deactivate Long URL Maker safely"
msgstr "ปิด Long URL Maker อย่างปลอดภัย"

#: includes/class-parich-slug-schema.php:326
msgid "Parich Long Slug could not finish its setup."
msgstr "Parich Long Slug ตั้งค่าไม่สำเร็จ"

#: includes/class-parich-slug-schema.php:332
msgid "Try again"
msgstr "ลองอีกครั้ง"

#: includes/class-parich-slug-schema.php:353
msgid "A WordPress database update shortened the slug columns."
msgstr "การอัปเดตฐานข้อมูล WordPress หดคอลัมน์ slug"

#. translators: %d: number of slugs
#: includes/class-parich-slug-schema.php:357
#, php-format
msgid "Parich Long Slug widened them again and restored %d slug that had been cut to 200 characters."
msgid_plural "Parich Long Slug widened them again and restored %d slugs that had been cut to 200 characters."
msgstr[0] "Parich Long Slug ขยายคอลัมน์กลับแล้ว และคืนค่า slug ที่ถูกตัดเหลือ 200 ตัวอักษร %d รายการ"

#. translators: 1: number of slugs, 2: list such as "post:12, term:5"
#: includes/class-parich-slug-schema.php:364
#, php-format
msgid "%1$d slug was left as it is because it changed after being cut: %2$s."
msgid_plural "%1$d slugs were left as they are because they changed after being cut: %2$s."
msgstr[0] "ไม่แตะ slug %1$d รายการ เพราะถูกเปลี่ยนหลังจากถูกตัด: %2$s"

#: includes/class-parich-slug-schema.php:377
msgid "Dismiss"
msgstr "ปิดข้อความนี้"

#: includes/class-parich-slug-schema.php:391
msgid "Sorry, you are not allowed to dismiss this notice."
msgstr "ขออภัย คุณไม่มีสิทธิ์ปิดข้อความนี้"

#: includes/class-parich-slug-schema.php:409
msgid "Sorry, you are not allowed to change the database for this plugin."
msgstr "ขออภัย คุณไม่มีสิทธิ์แก้ไขฐานข้อมูลสำหรับปลั๊กอินนี้"

#. translators: %d: number of redirects
#: includes/repair/class-parich-slug-repair-admin.php:64
#, php-format
msgid "Parich Long Slug redirects %d old address to a repaired post or term. Redirects stop when the plugin is deactivated, and are deleted with it."
msgid_plural "Parich Long Slug redirects %d old addresses to repaired posts and terms. Redirects stop when the plugin is deactivated, and are deleted with it."
msgstr[0] "Parich Long Slug เปลี่ยนเส้นทางที่อยู่เดิม %d รายการไปยังเรื่องหรือหมวดหมู่ที่กู้คืนแล้ว การเปลี่ยนเส้นทางจะหยุดเมื่อปิดใช้งานปลั๊กอิน และถูกลบไปพร้อมปลั๊กอิน"

#: includes/repair/class-parich-slug-repair-admin.php:68
msgid "Download them first to keep them in another redirect plugin."
msgstr "ดาวน์โหลดไว้ก่อนเพื่อนำไปใช้กับปลั๊กอินเปลี่ยนเส้นทางตัวอื่น"

#: includes/repair/class-parich-slug-repair-admin.php:89
msgid "Starting the scan…"
msgstr "กำลังเริ่มสแกน…"

#. translators: 1: step name, 2: objects checked so far
#: includes/repair/class-parich-slug-repair-admin.php:91
#, php-format
msgid "Scanning: %1$s — %2$d posts and terms checked"
msgstr "กำลังสแกน: %1$s — ตรวจเรื่องและหมวดหมู่แล้ว %2$d รายการ"

#: includes/repair/class-parich-slug-repair-admin.php:92
msgid "Scan finished. Loading the results…"
msgstr "สแกนเสร็จแล้ว กำลังโหลดผล…"

#: includes/repair/class-parich-slug-repair-admin.php:93
msgid "The scan stopped with an error. Try again; the scan restarts from the beginning."
msgstr "การสแกนหยุดเพราะเกิดข้อผิดพลาด ลองอีกครั้ง การสแกนจะเริ่มใหม่ตั้งแต่ต้น"

#. translators: 1: items done, 2: items in all
#: includes/repair/class-parich-slug-repair-admin.php:98
#, php-format
msgid "Repairing: %1$d of %2$d…"
msgstr "กำลังกู้คืน: %1$d จาก %2$d…"

#: includes/repair/class-parich-slug-repair-admin.php:99
msgid "Change the slugs of the selected items? A redirect is made from every old address. You can undo the whole batch later."
